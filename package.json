    "@red-cup-engineering/hive-blockchain-client-service": "0.1.5",
    "@red-cup-engineering/read-hive-account-history-service": "0.1.1",
    "@red-cup-engineering/read-hive-engine-account-history-service": "0.1.5",
    "@red-cup-engineering/exact-number-data-service": "0.1.5"
  },
  "scripts": {
    "check": "node --check hive-auto-ledger-cli.mjs",
